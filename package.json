{
  "name": "metafold",
  "version": "0.3.2",
  "description": "Metafold SDK for Node.js",
  "main": "lib/metafold.js",
  "type": "module",
  "scripts": {
    "lint": "eslint --ext '.ts' .",
    "build": "tsc",
    "bundle": "tsc --noEmit && node bundle.mjs",
    "test": "tsc -p tsconfig.test.json && mocha",
    "predocs": "yarn build",
    "docs": "jsdoc -c .jsdoc.json lib"
  },
  "mocha": {
    "extension": [
      "ts"
    ],
    "spec": "src/**/*.spec.ts",
    "require": "tsx/esm"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Metafold3d/metafold-node.git"
  },
  "keywords": [
    "metafold",
    "api",
    "sdk",
    "implicit geometry"
  ],
  "author": "Metafold 3D",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Metafold3d/metafold-node/issues"
  },
  "homepage": "https://github.com/Metafold3d/metafold-node#readme",
  "devDependencies": {
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.11.17",
    "@typescript-eslint/eslint-plugin": "^7.0.1",
    "@typescript-eslint/parser": "^7.0.1",
    "commander": "^12.0.0",
    "esbuild": "^0.20.1",
    "eslint": "^8.56.0",
    "jsdoc": "^4.0.2",
    "minami": "^1.2.3",
    "mocha": "^10.2.0",
    "nock": "^13.5.1",
    "taffydb": "^2.7.3",
    "three": "^0.164.1",
    "tsx": "^4.9.3",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "@types/three": "^0.164.0",
    "axios": "^1.6.7"
  }
}
